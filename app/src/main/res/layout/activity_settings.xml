<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<TextView android:id="@+id/hAudio" style="@style/Heading" android:text="@string/audio_heading" />

		<CheckBox
			android:id="@+id/preferAd"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/prefer_ad" />

		<TextView style="@style/FieldLabel" android:labelFor="@+id/keywords" android:text="@string/preferred_tracks" />
		<EditText android:id="@+id/keywords" style="@style/Field" android:hint="@string/preferred_tracks_hint" android:inputType="text" />

		<TextView android:id="@+id/hPlayback" style="@style/Heading" android:text="@string/playback_heading" />

		<CheckBox
			android:id="@+id/external"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/use_external_player" />

		<CheckBox
			android:id="@+id/showUrl"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="48dp"
			android:text="@string/show_stream_url" />

		<TextView android:id="@+id/hGuide" style="@style/Heading" android:text="@string/guide_heading" />

		<TextView style="@style/FieldLabel" android:labelFor="@+id/days" android:text="@string/guide_days" />
		<EditText android:id="@+id/days" style="@style/Field" android:inputType="number" />
	</LinearLayout>
</ScrollView>

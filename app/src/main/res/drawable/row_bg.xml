<?xml version="1.0" encoding="utf-8"?>
<!-- A thick, high-contrast outline for D-pad focus so low-vision TV users can follow it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_focused="true">
		<shape>
			<solid android:color="@color/focus_fill" />
			<stroke android:width="3dp" android:color="@color/focus_ring" />
		</shape>
	</item>
	<item android:state_pressed="true">
		<shape><solid android:color="@color/focus_fill" /></shape>
	</item>
	<item android:drawable="@android:color/transparent" />
</selector>

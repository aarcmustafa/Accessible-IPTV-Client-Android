<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

	<!-- One APK for phones, tablets and Android TV: no touchscreen required, TV launcher optional. -->
	<uses-feature android:name="android.hardware.touchscreen" android:required="false" />
	<uses-feature android:name="android.software.leanback" android:required="false" />

	<application
		android:name=".App"
		android:allowBackup="true"
		android:banner="@drawable/tv_banner"
		android:icon="@drawable/ic_launcher"
		android:label="@string/app_name"
		android:largeHeap="true"
		android:supportsRtl="true"
		android:theme="@style/AppTheme"
		android:usesCleartextTraffic="true">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:windowSoftInputMode="stateHidden|adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity>
		<activity
			android:name=".PlayerActivity"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
			android:theme="@style/PlayerTheme" />
		<activity android:name=".ProgrammesActivity" android:windowSoftInputMode="stateHidden" />
		<activity android:name=".SourcesActivity" />
		<activity android:name=".RecordingsActivity" />
		<activity android:name=".SettingsActivity" android:windowSoftInputMode="stateHidden" />
		<activity android:name=".HelpActivity" />

		<service
			android:name=".RecordService"
			android:exported="false"
			android:foregroundServiceType="dataSync" />
		<receiver android:name=".Recorder$AlarmReceiver" android:exported="false" />
		<receiver android:name=".Recorder$BootReceiver" android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.BOOT_COMPLETED" />
			</intent-filter>
		</receiver>
		<activity android:name=".EpisodesActivity" />
		<receiver android:name=".Updater$InstallReceiver" android:exported="false" />
		<meta-data
			android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
			android:value="androidx.media3.cast.DefaultCastOptionsProvider" />
	</application>
</manifest>
